# =====================================================================
# Bloop - variables de entorno de DESARROLLO LOCAL.
# Copia este fichero como ".env" (start-dev.bat lo hace automaticamente).
# El fichero .env NUNCA se sube a Git. Aqui no hay secretos reales.
# =====================================================================

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=bloop
POSTGRES_USER=bloop
POSTGRES_PASSWORD=bloop
DB_URL=jdbc:postgresql://localhost:5432/bloop
DB_USERNAME=bloop
DB_PASSWORD=bloop

# --- Seguridad (minimo 32 caracteres). En produccion: valores largos y aleatorios. ---
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
QR_SECRET=dev-only-qr-secret-change-me-0123456789abcdef
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# --- Correo (ver README.md, "Variables de entorno") ---
# MAIL_ENABLED=false -> MODO PRUEBAS: los correos NO se envian; se guardan en el historial de correos
#                       del backoffice (Notificaciones) con estado "No enviado" y se escriben en el log.
# MAIL_ENABLED=true  -> se envian por SMTP. Por defecto a Mailpit (docker compose up -d mailpit):
#                       interfaz en http://localhost:8025 para ver los correos de prueba.
MAIL_ENABLED=false
MAIL_FROM=no-reply@bloop.local
MAIL_FROM_NAME=Bloop
# Servidor SMTP. Si NO las defines: localhost:1025 al ejecutar el backend en tu maquina y "mailpit"
# dentro de docker compose. Para un proveedor real (Brevo, Mailgun, SES, Gmail...) descomenta y rellena:
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-usuario-smtp
# MAIL_PASSWORD=tu-clave-smtp            (NUNCA la subas a Git: .env esta en .gitignore)
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS_ENABLE=true              (puerto 587)
# MAIL_SSL_ENABLE=false                  (true solo con el puerto 465)
# MAIL_TIMEOUT_MS=10000

# --- Aplicacion ---
PUBLIC_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Datos de demostracion (solo perfil dev): contrasena de todas las cuentas demo.
DEMO_DATA=true
DEMO_PASSWORD=Demo1234!
# Juego de datos demo: kembo (discoteca de Zaragoza con 3 meses de historia + 1 mes de proximas fiestas)
# o noctambula (el antiguo, con DEMO_HISTORY_DAYS).
DEMO_DATASET=kembo

# --- Seguridad avanzada (fase 4) ---
# Rotacion de claves: pon aqui las claves ANTERIORES separadas por comas (solo validan, no firman).
JWT_PREVIOUS_SECRETS=
QR_PREVIOUS_SECRETS=
# Bloqueo temporal tras N intentos de login fallidos (por email + IP).
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- Stripe en modo TEST (opcional; sin claves solo existe el pago simulado) ---
# Claves de prueba de tu cuenta de Stripe (https://dashboard.stripe.com/test/apikeys).
# Nunca uses claves "live": Bloop solo acepta claves que empiezan por sk_test_.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
# Secreto de firma del webhook (whsec_...). En local lo da: stripe listen --forward-to localhost:8080/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Imagenes (ver README.md, "Variables de entorno") ---
# local      -> carpeta de disco FUERA del proyecto (por defecto ~/.bloop/media). Solo desarrollo.
# cloudinary -> almacenamiento en la nube con CDN (recomendado). Cuenta gratuita en https://cloudinary.com
MEDIA_PROVIDER=local
# MEDIA_LOCAL_DIR=C:/bloop-media
# MEDIA_PUBLIC_BASE_URL=http://localhost:8080
# MEDIA_CLOUDINARY_CLOUD_NAME=
# MEDIA_CLOUDINARY_API_KEY=
# MEDIA_CLOUDINARY_API_SECRET=           (secreto: solo en .env, nunca en el repositorio)
# MEDIA_FOLDER=bloop
# MEDIA_MAX_BYTES=5242880

# --- Historico de demostracion (solo perfil dev) ---
# Solo para DEMO_DATASET=noctambula (Kembo genera siempre sus 4 meses).
# Genera N dias de actividad realista (ventas, asistencia, TPV, reservas...) en la empresa demo.
# Se ejecuta una sola vez. 0 = desactivado. Ver README.md
DEMO_HISTORY_DAYS=120
